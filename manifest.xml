        <bt:Image id="alignTop.32" DefaultValue="https://deddytann.github.io/deli-elements/assets/alignTop-32.png"/>
        <bt:Image id="alignTop.80" DefaultValue="https://deddytann.github.io/deli-elements/assets/alignTop-80.png"/>
        <bt:Image id="alignMiddle.16" DefaultValue="https://deddytann.github.io/deli-elements/assets/alignMiddle-16.png"/>
        <bt:Image id="alignMiddle.32" DefaultValue="https://deddytann.github.io/deli-elements/assets/alignMiddle-32.png"/>
        <bt:Image id="alignMiddle.80" DefaultValue="https://deddytann.github.io/deli-elements/assets/alignMiddle-80.png"/>
        <bt:Image id="alignBottom.16" DefaultValue="https://deddytann.github.io/deli-elements/assets/alignBottom-16.png"/>
        <bt:Image id="alignBottom.32" DefaultValue="https://deddytann.github.io/deli-elements/assets/alignBottom-32.png"/>
        <bt:Image id="alignBottom.80" DefaultValue="https://deddytann.github.io/deli-elements/assets/alignBottom-80.png"/>
        <bt:Image id="distH.16" DefaultValue="https://deddytann.github.io/deli-elements/assets/distH-16.png"/>
        <bt:Image id="distH.32" DefaultValue="https://deddytann.github.io/deli-elements/assets/distH-32.png"/>
        <bt:Image id="distH.80" DefaultValue="https://deddytann.github.io/deli-elements/assets/distH-80.png"/>
        <bt:Image id="distV.16" DefaultValue="https://deddytann.github.io/deli-elements/assets/distV-16.png"/>
        <bt:Image id="distV.32" DefaultValue="https://deddytann.github.io/deli-elements/assets/distV-32.png"/>
        <bt:Image id="distV.80" DefaultValue="https://deddytann.github.io/deli-elements/assets/distV-80.png"/>
        <bt:Image id="sameSize.16" DefaultValue="https://deddytann.github.io/deli-elements/assets/sameSize-16.png"/>
        <bt:Image id="sameSize.32" DefaultValue="https://deddytann.github.io/deli-elements/assets/sameSize-32.png"/>
        <bt:Image id="sameSize.80" DefaultValue="https://deddytann.github.io/deli-elements/assets/sameSize-80.png"/>
        <bt:Image id="swapShapes.16" DefaultValue="https://deddytann.github.io/deli-elements/assets/swapShapes-16.png"/>
        <bt:Image id="swapShapes.32" DefaultValue="https://deddytann.github.io/deli-elements/assets/swapShapes-32.png"/>
        <bt:Image id="swapShapes.80" DefaultValue="https://deddytann.github.io/deli-elements/assets/swapShapes-80.png"/>
      </bt:Images>
      <bt:Urls>
        <bt:Url id="Taskpane.Url" DefaultValue="https://deddytann.github.io/deli-elements/taskpane.html"/>
        <bt:Url id="Commands.Url" DefaultValue="https://deddytann.github.io/deli-elements/commands.html"/>
      </bt:Urls>
      <bt:ShortStrings>
        <bt:String id="Tab.Label" DefaultValue="Deli"/>
        <bt:String id="Main.Label" DefaultValue="Deli Elements"/>
        <bt:String id="Align.Label" DefaultValue="Align"/>
        <bt:String id="Arrange.Label" DefaultValue="Arrange"/>
        <bt:String id="Open.Label" DefaultValue="Elements"/>
        <bt:String id="GetStarted.Title" DefaultValue="Deli Elements is ready"/>
        <bt:String id="alignLeft.Label" DefaultValue="Left"/>
        <bt:String id="alignCenter.Label" DefaultValue="Center"/>
        <bt:String id="alignRight.Label" DefaultValue="Right"/>
        <bt:String id="alignTop.Label" DefaultValue="Top"/>
        <bt:String id="alignMiddle.Label" DefaultValue="Middle"/>
        <bt:String id="alignBottom.Label" DefaultValue="Bottom"/>
        <bt:String id="distH.Label" DefaultValue="Across"/>
        <bt:String id="distV.Label" DefaultValue="Down"/>
        <bt:String id="sameSize.Label" DefaultValue="Same size"/>
        <bt:String id="swapShapes.Label" DefaultValue="Swap"/>
      </bt:ShortStrings>
      <bt:LongStrings>
        <bt:String id="Open.Tip" DefaultValue="Open the Deli Elements panel: insert elements, layout tools, branded tables and a brand check."/>
        <bt:String id="GetStarted.Desc" DefaultValue="Open the Deli tab on the ribbon and click Elements."/>
        <bt:String id="alignLeft.Tip" DefaultValue="Align selected shapes to the leftmost edge (one shape: to the slide)."/>
        <bt:String id="alignCenter.Tip" DefaultValue="Center selected shapes horizontally."/>
        <bt:String id="alignRight.Tip" DefaultValue="Align selected shapes to the rightmost edge."/>
        <bt:String id="alignTop.Tip" DefaultValue="Align selected shapes to the top edge."/>
        <bt:String id="alignMiddle.Tip" DefaultValue="Center selected shapes vertically."/>
        <bt:String id="alignBottom.Tip" DefaultValue="Align selected shapes to the bottom edge."/>
        <bt:String id="distH.Tip" DefaultValue="Equal horizontal gaps between 3 or more shapes."/>
        <bt:String id="distV.Tip" DefaultValue="Equal vertical gaps between 3 or more shapes."/>
        <bt:String id="sameSize.Tip" DefaultValue="Resize to match the first selected shape."/>
        <bt:String id="swapShapes.Tip" DefaultValue="Swap the positions of two shapes."/>
      </bt:LongStrings>
